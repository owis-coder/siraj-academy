# ============================================================
# خادم أكاديمية سراج التعليمية — متغيرات البيئة (.env.example)
# انسخ هذا الملف إلى .env واضبط القيم وفق بيئة التشغيل لديك
# ============================================================

# قاعدة البيانات (PostgreSQL)
# الافتراضي للتطوير المحلي عبر Docker أو WSL أو خدمة محلية:
DATABASE_URL="postgresql://siraj:siraj_dev_2024@localhost:5432/siraj?schema=public"

# منفذ خادم الواجهة الخلفية (Express)
PORT=4000
NODE_ENV=development

# رابط الواجهة الأمامية (Vite React) لضبط CORS وروابط التفعيل والتنبيهات
CLIENT_URL="http://localhost:5173"

# رابط الواجهة الأساسي المستخدم في روابط البريد (تفعيل الحساب، تأكيد تغيير البريد،
# واستعادة كلمة المرور: /reset-password?token=...). في التطوير = http://localhost:5173
# في الإنتاج ضع نطاق الموقع الفعلي، ولا تُثبّت أي عنوان داخل الكود.
APP_BASE_URL="http://localhost:5173"

# بريد الإدارة المستقبِل لكافة إشعارات المنصة (تسجيل مستخدمين جدد، طلبات خدمات مخصصة):
ADMIN_NOTIFICATION_EMAIL="owisowis821@gmail.com"

# سر توقيع JWT لجلسات المستخدمين (HttpOnly Cookies) — غيّره بقيمة عشوائية قوية في الإنتاج
JWT_SECRET="siraj-dev-secret-change-me-to-a-strong-random-key"

# مجلد حفظ الملفات المرفوعة (سندات الدفع، المرفقات، مستندات التحقق)
UPLOAD_DIR="uploads"

# ============================================================
# إعدادات مزود البريد الإلكتروني (SMTP)
# ============================================================
# ملاحظة هامة:
# إذا تُركت قيم SMTP فارغة، سيعمل الخادم في وضع الاختبار الآمن (Safe Simulation Mode):
# حيث تُسجّل الرسائل في الكونسول وفي جدول EmailLog مع الوسم SIMULATED دون تعطل الخادم
# ودون إدعاء كاذب بأن الرسالة سُلمت فعليًا لصندوق الوارد.
#
# لتفعيل الإرسال الحقيقي إلى owisowis821@gmail.com من بيئة localhost:
#
# الخيار (1) — حساب بريد Gmail مع كلمة مرور التطبيقات (App Password):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"   # 16 حرفًا من إدارة حساب Google -> الأمان -> كلمات مرور التطبيقات
# SMTP_FROM="أكاديمية سراج <your-email@gmail.com>"
#
# الخيار (2) — خدمة Brevo (Sendinblue سابقاً):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-brevo-login-email"
# SMTP_PASS="your-brevo-smtp-key"
# SMTP_FROM="أكاديمية سراج <verified-sender@domain.com>"
#
# الخيار (3) — خدمة Resend:
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=465
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxxxxxxxxxxxxx"
# SMTP_FROM="أكاديمية سراج <onboarding@resend.dev>"
#
# بعد ضبط القيم: أعد تشغيل الخادم ثم تحقق من الاتصال وأرسل رسالة اختبار حقيقية:
#   npm run mail:test -- you@example.com     (فحص الاتصال + إرسال رسالة اختبار)
#   npm run mail:inbox                        (إثبات وصول بريد استعادة كلمة المرور إلى صندوق وارد)
# إن أردت تجربة صندوق وار�� دون بيانات اعتماد: npm run mail:inbox ينشئ صندوق Ethereal مؤقتًا ويطبع رابطه.
#
# SMTP_SECURE اختياري: يُستنتج تلقائيًا من المنفذ (465 = تشفير مباشر) ويمكن تجاوزه true/false.
SMTP_SECURE=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="أكاديمية سراج <no-reply@siraj.sa>"

# رابط الواجهة المستخدم في رسائل التفعيل واستعادة كلمة المرور (localhost في التطوير)
APP_BASE_URL="http://localhost:5173"

# رابط تليجرام الرسمي المعتمد
TELEGRAM_LINK="https://t.me/Siraj1Academy"

# ============================================================
# منظومة الحماية والأمان المتقدمة (Application Security)
# ============================================================

# 1. وسيط الذاكرة المشتركة لتحديد معدل الطلبات (Redis / Valkey)
# اختياري: إن لم يُحدد، سيعمل الخادم تلقائيًا في وضع الذاكرة المحلية (In-Memory Fallback)
# REDIS_URL="redis://localhost:6379"

# 2. حماية Google reCAPTCHA v2 (Checkbox) / v3 / Enterprise
# عند تركها فارغة، يعمل الخادم تلقائيًا في وضع المحاكاة الآمنة (Simulated Mode)
# دون تعطل أو إيقاف النماذج للمطورين (ممنوع في الإنتاج ويجب توفير المفاتيح).
# RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
# RECAPTCHA_MODE="v2"           # "v2" (Checkbox - الموصى به) أو "v3" أو "enterprise" أو "simulated"
# RECAPTCHA_MIN_SCORE="0.5"     # خاص بـ v3 فقط: الحد الأدنى لدرجة الأمان (0.0 إلى 1.0)
# ALLOWED_HOSTNAME="siraj.sa"    # اسم النطاق المعتمد لرمز التحقق

# 3. مفتاح تشفير أسرار المصادقة الثنائية (TOTP Encryption Key - AES-256-GCM)
# يجب توليده كـ 32 بايت (64 محرف Hex) في بيئة الإنتاج: openssl rand -hex 32
# TOTP_ENCRYPTION_KEY=""

# 4. التحكم في محدد معدل الطلبات وحالة الطوارئ
RATE_LIMIT_ENABLED="true"
EMERGENCY_MODE="false"

# 5. تنبيهات الحوادث الأمنية الفورية (عبر البريد الإلكتروني)
SECURITY_ALERT_EMAIL="owisowis821@gmail.com"

# 6. شبكة Cloudflare وحماية تزييف عناوين IP ودرع الأصل (Origin Shield)
CLOUDFLARE_ENABLED="true"
# TRUSTED_PROXIES="127.0.0.1,10.0.0.0/8"

# Google OAuth 2.0 Web Client credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
