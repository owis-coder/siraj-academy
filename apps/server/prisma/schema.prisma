// ============================================================
// أكاديمية سراج التعليمية — مخطط قاعدة البيانات (PostgreSQL)
//.community contract: docs/api-contract.md
// ملاحظات نزاهة: لا بيانات وهمية — كل حالات الطلبات/الدفع تُدار
// سيرًا حقيقيًا من الـAPI (لا نجاح تلقائي للدفع، لا إدخال يدوي للمراجعات).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- التعدادات ----------

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AccessType {
  TRIAL
  PAID
}

enum OfferingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  REJECTED
}

enum ExplainRequestStatus {
  PENDING_REVIEW
  OPEN
  TEACHER_SELECTED
  CLOSED
  REJECTED
}

enum ExplainType {
  ONLINE
  IN_PERSON
  BOTH
}

enum Urgency {
  NOW
  DAY
  WEEK
  TERM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OrderTargetType {
  OFFERING
  SERVICE
  OFFER
  CUSTOM
}

enum OrderStatus {
  AWAITING_PAYMENT
  AWAITING_REVIEW
  REJECTED
  PAID
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  GATEWAY
}

enum PaymentStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ChatRoomType {
  DIRECT
  GROUP
  ORDER
}

enum ChatRole {
  MEMBER
  ADMIN
}

enum ChatReportStatus {
  NEW
  RESOLVED
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  HIDDEN
  EXPIRED
}

enum ServiceCategory {
  PRIVATE_EXPLAIN        // شرح خاص
  LIVE_EXPLAIN           // شرح مباشر
  SUMMARY                // تلخيص (تدريب على التلخيص)
  TRANSLATION            // ترجمة (تدريب على الترجمة)
  PPT                    // عروض تقديمية (تدريب)
  PROGRAMMING_PROJECT    // مشاريع برمجية (تدريب)
  RESEARCH_REVIEW        // مراجعة بحث (توجيه)
  PROOFREADING           // تدقيق لغوي (تدريب)
  ACADEMIC_FORMAT        // تنسيق أكاديمي (تدريب)
  HOMEWORK_TRAINING      // حل وتمرين واجبات
  ACADEMIC_CONSULT       // استشارة أكاديمية
  CUSTOM                 // مخصصة
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum FavoriteTargetType {
  SERVICE
  OFFERING
  TEACHER
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_CHANGE
  EMAIL_VERIFY
}

// ---------- المستخدمون ----------

model User {
  id                     String          @id @default(cuid())
  fullName               String
  username               String          @unique
  email                  String          @unique
  passwordHash           String
  whatsapp               String?
  role                   Role            @default(STUDENT)
  emailVerified          Boolean         @default(false)
  emailVerifiedAt        DateTime?       // وقت التوثيق الفعلي (للعرض وسجل التدقيق)
  emailVerificationToken String?          @db.VarChar(255)
  universityId           String?
  majorId                String?
  status                 UserStatus      @default(ACTIVE)
  level                  String?         // المستوى الدراسي للطالب
  avatarUrl              String?         // صورة الملف الشخصي (ملف محلي باسم يورده الخادم)
  pendingEmail           String?         // بريد جديد بانتظار التحقق — لا يُعتمد تلقائيًا
  sessionVersion         Int             @default(0) // يزداد لإبطال كل الجلسات القديمة
  totpSecret             String?         // سر المصادقة الثنائية (TOTP base32)
  totpEnabled            Boolean         @default(false) // هل المصادقة الثنائية مفعّلة
  totpBackupCodes        String?         // رموز الاسترجاع الاحتياطية (تجزئات SHA-256 بتنسيق JSON)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  major      Major?      @relation(fields: [majorId], references: [id], onDelete: SetNull)

  teacherProfile         TeacherProfile?
  explainRequests        ExplainRequest[]       @relation("StudentRequests")
  customRequests         CustomServiceRequest[] @relation("UserCustomRequests")
  orders                 Order[]                @relation("StudentOrders")
  enrollments      Enrollment[]
  paymentsReviewed Payment[]        @relation("PaymentReviewer")
  messages         Message[]
  chatParticipants ChatParticipant[]
  ownedRooms       ChatRoom[]       @relation("RoomOwner")
  notifications    Notification[]
  liveBookings     LiveBooking[]
  reviews          Review[]
  favorites        Favorite[]
  reportedChats    ChatReport[]
  blockedBy        Block[]          @relation("BlockTarget")
  blocking         Block[]          @relation("BlockOwner")
  sessions         UserSession[]
  oauthAccounts    OAuthAccount[]
  authTokens       AuthToken[]
  auditLogs        AuditLog[]
  refundsRequested       RefundRequest[]         @relation("StudentRefunds")
  refundsReviewed        RefundRequest[]         @relation("RefundReviewer")
  withdrawalsReviewed    TeacherWithdrawal[]     @relation("WithdrawalReviewer")
  journalEntriesCreated  FinancialJournalEntry[] @relation("JournalCreator")
  ledgerLines            FinancialLedgerLine[]   @relation("LedgerUser")
  adminPermissions       String[]                @default([])
  targetRecoveries       AccountRecoveryRequest[] @relation("TargetUserRecoveries")
  initiatedRecoveries    AccountRecoveryRequest[] @relation("RecoveryInitiator")
  reviewedRecoveries     AccountRecoveryRequest[] @relation("RecoveryReviewer")
  recoveryApprovals      AccountRecoveryApproval[] @relation("RecoveryApprover")

  @@index([role])
  @@index([status])
}

// ---------- رموز الأمان لمرة واحدة (استعادة كلمة المرور / تغيير البريد) ----------
// يُخزَّن تجزئة الرمز (SHA-256) فقط، ولا يُخزَّن الرمز الأصلي إطلاقًا.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// ---------- سجل الجلسات والأجهزة ----------
// لا يُخزَّن رمز الجلسة ولا ملفات تعريف الارتباط هنا — فقط بيانات وصفية.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?
  endReason  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
}

// ---------- هويات المصادقة الخارجية (Google OAuth) ----------
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "google", etc.
  providerSubjectId String   // معرّف sub الصادر من المزود
  email             String?  // البريد الموثق من المزود
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastUsedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubjectId])
  @@index([userId])
  @@index([provider, email])
}

// ---------- سجل التدقيق الشامل ----------
// لا تُسجَّل هنا كلمات المرور أو الرموز أو الجلسات أو أي سر — القيم الحساسة تُحجب.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorRole  String?
  action     String
  category   String   @default("ACCOUNT")
  result     String   @default("SUCCESS")
  reason     String?
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  requestId  String?
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
}

model TeacherProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree          String
  bio             String
  specialties     String[]
  universitiesText String?
  status          TeacherStatus @default(PENDING)
  docsUrl         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  offerings    CourseOffering[]
  services     Service[]        @relation("ServiceProvider")
  offers       Offer[]
  ads          Ad[]
  liveSessions LiveSession[]
  providedOrders Order[]        @relation("OrderProvider")
  payoutMethods  TeacherPayoutMethod[]
  withdrawals    TeacherWithdrawal[]
  earnings       TeacherEarning[]

  @@index([status])
}

// ---------- تصفح: جامعة -> كلية -> تخصص -> مقرر ----------

model University {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String?
  logoUrl   String?
  isVisible Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  colleges        College[]
  majors          Major[]
  courses         Course[]
  students        User[]
  explainRequests ExplainRequest[]

  @@index([isVisible])
}

model College {
  id           String   @id @default(cuid())
  universityId String
  name         String
  createdAt    DateTime @default(now())

  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  majors          Major[]
  courses         Course[]
  explainRequests ExplainRequest[]

  @@index([universityId])
}

// التخصص يمكن ربطه بالجامعة مباشرة أو بالكلية (collegeId اختياري)
model Major {
  id           String   @id @default(cuid())
  universityId String
  collegeId    String?
  name         String
  createdAt    DateTime @default(now())

  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  college         College?   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users           User[]
  courses         Course[]
  explainRequests ExplainRequest[]

  @@index([universityId])
  @@index([collegeId])
}

model Course {
  id          String    @id @default(cuid())
  universityId String
  collegeId   String?
  majorId     String?
  title       String
  code        String?
  level       String?
  description String?
  isVisible   Boolean   @default(true)
  coverUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  university University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  college    College?      @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  major      Major?        @relation(fields: [majorId], references: [id], onDelete: SetNull)
  offerings  CourseOffering[]

  @@index([universityId])
  @@index([collegeId])
  @@index([majorId])
  @@index([isVisible])
}

// ---------- الدورات (CourseOffering) والدروس ----------

model CourseOffering {
  id            String         @id @default(cuid())
  courseId      String
  teacherId     String
  title         String?
  summary       String
  price         Float
  trialVideoUrl String?
  youtubeUrls   Json?
  accessType    AccessType     @default(PAID)
  status        OfferingStatus @default(DRAFT)
  adminNote     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  enrollments  Enrollment[]
  reviews      Review[]
  liveSessions LiveSession[]

  @@index([courseId])
  @@index([teacherId])
  @@index([status])
  @@index([courseId, status])
}

model Lesson {
  id         String     @id @default(cuid())
  offeringId String
  title      String
  videoUrl   String
  access     AccessType @default(PAID)
  order      Int        @default(0)
  createdAt  DateTime   @default(now())

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, order])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  offeringId String
  createdAt  DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([userId, offeringId])
  @@index([userId])
  @@index([offeringId])
}

// ---------- الخدمات ----------

model Service {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  category     ServiceCategory
  description  String
  basePrice    Float?
  durationDays Int?
  providerId   String?
  isActive     Boolean         @default(true)
  isFeatured   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  provider TeacherProfile? @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([providerId])
}

// ---------- طلبات الشرح والعروض ----------

model ExplainRequest {
  id           String   @id @default(cuid())
  studentId    String
  universityId String?
  collegeId    String?
  majorId      String?
  courseTitle  String
  details      String
  type         ExplainType @default(ONLINE)
  urgency      Urgency     @default(WEEK)
  budget       Float?
  deadline     String?     // نص حر: "قبل منتصف الأسبوع القادم" إلخ
  attachments  Json?
  linkUrl      String?
  status       ExplainRequestStatus @default(PENDING_REVIEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  student    User       @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  college    College?    @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  major      Major?      @relation(fields: [majorId], references: [id], onDelete: SetNull)
  offers     Offer[]

  @@index([studentId])
  @@index([status])
  @@index([universityId])
}

model Offer {
  id           String      @id @default(cuid())
  requestId    String
  teacherId    String
  price        Float
  message      String?
  timelineDays Int?
  status       OfferStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  request ExplainRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teacher TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([requestId, teacherId])
  @@index([teacherId])
  @@index([status])
}

// ---------- الطلبات والدفع (تحويل بنكي يدوي — لا نجاح تلقائي) ----------

model Order {
  id         String          @id @default(cuid())
  orderNo    String          @unique
  studentId  String
  targetType OrderTargetType
  targetId   String?
  amount     Float
  title      String
  status     OrderStatus     @default(AWAITING_PAYMENT)
  notes      String?
  providerId String?         // المدرس المستفيد (للعروض/الدورات/الجلسات/الخدمات بآداء)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  student      User            @relation("StudentOrders", fields: [studentId], references: [id], onDelete: Cascade)
  provider     TeacherProfile? @relation("OrderProvider", fields: [providerId], references: [id], onDelete: SetNull)
  payments     Payment[]
  chatRooms    ChatRoom[]      @relation("RoomOrder")
  liveBookings LiveBooking[]   @relation("BookingOrder")
  refundRequests  RefundRequest[]
  teacherEarnings TeacherEarning[]

  @@index([studentId])
  @@index([status])
  @@index([providerId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  method     PaymentMethod @default(TRANSFER)
  receiptUrl String?
  status     PaymentStatus @default(UNDER_REVIEW)
  reviewerId String?
  reviewNote String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("PaymentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

// ---------- المحادثات ----------

model ChatRoom {
  id        String       @id @default(cuid())
  type      ChatRoomType @default(DIRECT)
  ownerId   String?
  title     String?
  orderId   String?      // غرفة مرتبطة بطلب شرح/دورة
  createdAt DateTime     @default(now())

  owner        User?             @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  order        Order?            @relation("RoomOrder", fields: [orderId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     Message[]
  reports      ChatReport[]

  @@index([type])
  @@index([orderId])
}

model ChatParticipant {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  role       ChatRole  @default(MEMBER)
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Message {
  id            String   @id @default(cuid())
  roomId        String
  senderId      String
  body          String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  room    ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports ChatReport[]

  @@index([roomId, createdAt])
}

model ChatReport {
  id         String           @id @default(cuid())
  roomId     String
  messageId  String?
  reporterId String
  reason     String
  status     ChatReportStatus @default(NEW)
  createdAt  DateTime         @default(now())

  room     ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message  Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporter User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockOwner", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// ---------- إعلانات المدرسين (دورة حياة مفروضة على الخادم) ----------

model Ad {
  id           String   @id @default(cuid())
  teacherId    String
  title        String
  body         String
  imageUrl     String?
  linkUrl      String?
  status       AdStatus @default(DRAFT)
  reviewerNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
}

// ---------- الإشعارات ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------- الجلسات المباشرة ----------

model LiveSession {
  id          String   @id @default(cuid())
  offeringId  String?
  teacherId   String
  title       String
  startsAt    DateTime
  durationMin Int      @default(60)
  price       Float?
  capacity    Int?
  createdAt   DateTime @default(now())

  offering CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  teacher  TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bookings LiveBooking[]

  @@index([offeringId])
  @@index([teacherId])
  @@index([startsAt])
}

model LiveBooking {
  id        String        @id @default(cuid())
  sessionId String
  userId    String
  status    BookingStatus @default(CONFIRMED)
  orderId   String?
  createdAt DateTime      @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?      @relation("BookingOrder", fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId])
}

// ---------- إعدادات المنصة ----------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- التقييمات والمفضلة ----------

model Review {
  id         String   @id @default(cuid())
  offeringId String
  userId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offeringId, userId])
  @@index([offeringId])
}

model Favorite {
  id         String             @id @default(cuid())
  userId     String
  targetId   String
  targetType FavoriteTargetType
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, targetType])
  @@index([userId])
}

// ---------- طلبات الخدمات المخصصة والشروحات غير المتوفرة ----------

enum CustomRequestType {
  COURSE_EXPLAIN      // شرح مقرر
  TOPIC_EXPLAIN       // شرح موضوع
  TRANSLATION         // ترجمة
  SUMMARY             // تلخيص
  PPT                 // عرض PowerPoint
  PROGRAMMING_PROJECT // مشروع برمجي تعليمي
  OTHER               // خدمة أخرى
}

enum CustomRequestStatus {
  NEW                 // جديد
  UNDER_REVIEW        // قيد المراجعة
  AWAITING_RESPONSE   // بانتظار الرد
  ACCEPTED            // قُبل
  REJECTED            // رُفض
  IN_PROGRESS         // قيد التنفيذ
  COMPLETED           // مكتمل
}

model CustomServiceRequest {
  id             String              @id @default(cuid())
  requestNo      String              @unique
  userId         String
  requestType    CustomRequestType   @default(COURSE_EXPLAIN)
  title          String              // اسم المقرر أو الخدمة
  description    String              // الوصف التفصيلي
  universityName String?             // الجامعة المرتبطة بالطلب
  majorName      String?             // التخصص المرتبط بالطلب
  academicLevel  String?             // المستوى الدراسي
  deadline       String?             // الموعد المطلوب
  budget         Float?              // الميزانية المقترحة
  attachments    Json?               // قائمة بالمرفقات الآمنة
  status         CustomRequestStatus @default(NEW)
  adminNotes     String?             // ملاحظات داخلية للإدارة
  emailSent      Boolean             @default(false)
  emailError     String?
  emailSentAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation("UserCustomRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@index([createdAt])
}

// ---------- سجل الإشعارات البريدية (لمنع التكرار وإعادة المحاولة) ----------

model EmailLog {
  id        String   @id @default(cuid())
  type      String   // REGISTRATION, CUSTOM_REQUEST, STATUS_UPDATE
  recipient String
  subject   String
  status    String   // SENT, FAILED, SIMULATED
  error     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([recipient])
  @@index([createdAt])
}

// ---------- قائمة العناوين المحظورة (IP Blacklist / Jail) ----------
model BlockedIp {
  id         String    @id @default(cuid())
  ip         String    @unique
  reason     String
  bannedAt   DateTime  @default(now())
  expiresAt  DateTime? // إذا كان null فهو حظر دائم
  bannedBy   String    @default("SYSTEM") // SYSTEM أو معرف الأدمن
  permanent  Boolean   @default(false)

  @@index([ip])
  @@index([expiresAt])
}

// ---------- سجل الحوادث الأمنية المتقدمة (Security Incidents) ----------
model SecurityIncident {
  id         String    @id @default(cuid())
  eventType  String    // RATE_LIMIT_BURST, BRUTE_FORCE, CAPTCHA_FAIL, PROBING, PRIVILEGE_ATTEMPT
  severity   String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  ip         String?
  userId     String?
  endpoint   String?
  details    Json?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([ip])
  @@index([createdAt])
  @@index([resolved])
}

// ============================================================
// النظام المالي والمحفظة ودفتر الأستاذ المزدوج (Double-Entry Ledger)
// ============================================================

enum FinancialAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryType {
  PAYMENT_DEPOSIT
  EARNING_REALIZATION
  WITHDRAWAL_RESERVE
  WITHDRAWAL_PAYOUT
  WITHDRAWAL_RELEASE
  REFUND_APPROVE
  REFUND_PAYOUT
  ADJUSTMENT
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

enum DebitCredit {
  DEBIT
  CREDIT
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PROCESSING
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  CANCELLED
}

enum EarningStatus {
  PENDING_CLEARING
  AVAILABLE
  WITHDRAWN
  REVERSED
}

model FinancialAccount {
  id          String               @id @default(cuid())
  code        String               @unique // 1010, 2010, 2020, 2021, 2030, 4010, 5010
  nameAr      String
  nameEn      String
  type        FinancialAccountType
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  ledgerLines FinancialLedgerLine[]

  @@index([type])
  @@index([isActive])
}

model FinancialJournalEntry {
  id            String             @id @default(cuid())
  entryNo       String             @unique // e.g. JRN-2026-000001
  type          JournalEntryType
  status        JournalEntryStatus @default(POSTED)
  currency      String             @default("SAR")
  totalAmount   Float              // مجموع الجانب المدين (ويساوي الدائن)
  referenceType String?            // ORDER, PAYMENT, REFUND, WITHDRAWAL
  referenceId   String?
  narrativeAr   String
  narrativeEn   String?
  createdById   String?
  createdAt     DateTime           @default(now())

  createdBy   User?                 @relation("JournalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines       FinancialLedgerLine[]
  refunds     RefundRequest[]
  withdrawals TeacherWithdrawal[]

  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model FinancialLedgerLine {
  id             String      @id @default(cuid())
  journalEntryId String
  accountId      String
  entryType      DebitCredit // DEBIT / CREDIT
  amount         Float
  currency       String      @default("SAR")
  userId         String?     // الحساب الفرعي للطالب أو المدرس للتدقيق (Sub-ledger)
  notes          String?
  createdAt      DateTime    @default(now())

  journalEntry FinancialJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user         User?                 @relation("LedgerUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([userId])
  @@index([entryType])
}

model TeacherPayoutMethod {
  id                     String   @id @default(cuid())
  teacherId              String
  bankName               String
  accountHolderName      String
  ibanEncrypted          String   // مشفر بـ AES-256-GCM (iv:authTag:ciphertext)
  ibanMasked             String   // SA****************1234
  accountNumberEncrypted  String?  // اختياري مشفر
  accountNumberMasked    String?  // اختياري مقنع
  isDefault              Boolean  @default(false)
  isVerified             Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  teacher     TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  withdrawals TeacherWithdrawal[]

  @@index([teacherId])
  @@index([isDefault])
}

model TeacherWithdrawal {
  id                  String           @id @default(cuid())
  withdrawalNo        String           @unique // e.g. WTH-2026-000001
  teacherId           String
  payoutMethodId      String
  amount              Float
  fee                 Float            @default(0)
  netAmount           Float
  currency            String           @default("SAR")
  status              WithdrawalStatus @default(PENDING)
  adminNotes          String?
  rejectionReason     String?
  transferProofUrl    String?          // صورة إشعار الحوالة البنكية
  transferReferenceNo String?          // الرقم المرجعي للحوالة البنكية الصادرة من حساب المنصة
  transferredAt       DateTime?
  reviewerId          String?
  executedById        String?
  journalEntryId      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  teacher      TeacherProfile         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  payoutMethod TeacherPayoutMethod    @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  reviewer     User?                  @relation("WithdrawalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  journalEntry FinancialJournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
}

model RefundRequest {
  id                  String       @id @default(cuid())
  refundNo            String       @unique // e.g. RFD-2026-000001
  orderId             String
  studentId           String
  amountRequested     Float
  amountApproved      Float?
  currency            String       @default("SAR")
  reason              String
  notes               String?
  attachments         Json?
  status              RefundStatus @default(PENDING)
  adminNotes          String?
  rejectionReason     String?
  transferProofUrl    String?      // صورة إشعار التحويل البنكي المرجع للطالب
  transferReferenceNo String?      // الرقم المرجعي للحوالة البنكية المستردة
  transferredAt       DateTime?
  bankDetails         Json?        // بيانات حساب الطالب المشفرة/المقنعة لتحويل الاسترداد
  reviewerId          String?
  executedById        String?
  journalEntryId      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  student      User                   @relation("StudentRefunds", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer     User?                  @relation("RefundReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  journalEntry FinancialJournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
}

model TeacherEarning {
  id               String        @id @default(cuid())
  orderId          String
  teacherId        String
  grossAmount      Float
  commissionRate   Float         // لقطة النسبة الثابتة وقت الاستحقاق
  commissionAmount Float
  netAmount        Float
  currency         String        @default("SAR")
  status           EarningStatus @default(AVAILABLE)
  clearingDate     DateTime?     // موعد إتاحة الرصيد للسحب
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // يدعم طلبات متعددة المدرسين ويمنع تكرار استحقاق نفس المدرس لنفس الطلب:
  @@unique([orderId, teacherId])
  @@index([teacherId])
  @@index([orderId])
  @@index([status])
}

// ---------- نظام استعادة الحسابات وإدارتها بواسطة المشرفين ----------

enum AccountRecoveryStatus {
  PENDING_APPROVAL
  APPROVED
  VERIFICATION_SENT
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum RecoveryVerificationMethod {
  NATIONAL_ID
  PASSPORT
  STUDENT_ID
  ACADEMIC_RECORD
  OFFICIAL_PHONE_CALL
  VIDEO_VERIFICATION
  DOCUMENT_UPLOAD
  OTHER
}

model AccountRecoveryRequest {
  id                 String                     @id @default(cuid())
  recoveryNo         String                     @unique // e.g. REC-2026-000001
  userId             String
  originalEmail      String
  alternativeEmail   String
  reason             String                     // سبب فقدان الوصول للبريد الأصلي
  verificationMethod RecoveryVerificationMethod @default(OTHER)
  verificationNotes  String?                    // ملاحظات الإدارة وتفاصيل التحقق
  evidenceRef        String?                    // الرقم المرجعي أو معرف التذكرة (لا تخزين لمستندات حساسة بلا داعٍ)
  isHighRisk         Boolean                    @default(false)
  approvalRequired   Boolean                    @default(false)
  status             AccountRecoveryStatus      @default(PENDING_APPROVAL)
  tokenHash          String?                    @unique // تجزئة SHA-256 لرمز التحقق
  tokenExpiresAt     DateTime?
  initiatorId        String
  reviewerId         String?
  reviewedAt         DateTime?
  reviewNotes        String?
  completedAt        DateTime?
  completedIp        String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  user      User                      @relation("TargetUserRecoveries", fields: [userId], references: [id], onDelete: Cascade)
  initiator User                      @relation("RecoveryInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  reviewer  User?                     @relation("RecoveryReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approvals AccountRecoveryApproval[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([alternativeEmail])
}

model AccountRecoveryApproval {
  id        String   @id @default(cuid())
  requestId String
  adminId   String
  decision  String   // APPROVED, REJECTED
  notes     String?
  createdAt DateTime @default(now())

  request AccountRecoveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  admin   User                   @relation("RecoveryApprover", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([requestId, adminId])
  @@index([requestId])
  @@index([adminId])
}




