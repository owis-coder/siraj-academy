{
  "name": "siraj-server",
  "version": "1.0.0",
  "private": true,
  "description": "API خادم أكاديمية سراج التعليمية — Express + TypeScript + Prisma + Socket.IO",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:demo:diverse": "tsx prisma/seed-demo-diverse.ts",
    "seed:demo:clean": "tsx prisma/seed-demo-cleanup.ts",
    "test:api": "tsx tests/api-permissions.ts && tsx tests/api-files-payments.ts",
    "test:account": "tsx tests/account-security.ts",
    "test:request": "tsx tests/request-detail.ts",
    "test:mail": "tsx tests/mail-delivery.ts",
    "mail:test": "tsx scripts/mail-test.ts",
    "mail:inbox": "tsx scripts/mail-inbox.ts",
    "backup:db": "tsx prisma/backup-db.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.0",
    "prisma": "^6.5.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {}
}
