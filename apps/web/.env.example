# Google reCAPTCHA v2 (Checkbox) / v3 Public Site Key
# Get this key from Google reCAPTCHA Admin Console (v2 Checkbox recommended)
VITE_RECAPTCHA_SITE_KEY=""

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=""

# API Base URL (defaults to /api/v1 via Vite proxy in development)
VITE_API_BASE="/api/v1"
